{
  "name": "product-design-system",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "description": "Figma-led design tokens and React library tooling.",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "packageManager": "npm@11.19.0",
  "workspaces": [
    "packages/tokens",
    "packages/react",
    "apps/storybook"
  ],
  "scripts": {
    "build:tokens": "npm run build --workspace=@product-design-system/tokens",
    "validate:tokens": "npm run validate --workspace=@product-design-system/tokens",
    "build:react": "npm run build --workspace=@product-design-system/react",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:tokens": "npm test --workspace=@product-design-system/tokens",
    "test:browser": "vitest run",
    "test": "npm run test:tokens && npm run test:browser",
    "storybook": "npm run dev --workspace=@product-design-system/storybook --",
    "build:storybook": "npm run build --workspace=@product-design-system/storybook",
    "build": "npm run build:tokens && npm run build:react && npm run build:storybook",
    "check:ci": "node scripts/check-ci.mjs",
    "verify": "npm run validate:tokens && npm run build:tokens && npm run build:react && npm run typecheck && npm test && npm run build:storybook && npm run check:ci"
  },
  "allowScripts": { "esbuild@0.28.2": true },
  "devDependencies": {
    "@types/node": "24.13.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/browser-playwright": "4.1.11",
    "axe-core": "4.13.0",
    "playwright": "1.63.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "6.0.3",
    "vite": "8.3.1",
    "vitest": "4.1.11",
    "vitest-browser-react": "2.3.0",
    "yaml": "2.9.1"
  }
}
